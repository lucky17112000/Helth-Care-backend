model MedicalReport {
    id         String   @id @default(uuid()) @db.Uuid
    reportName String
    reportLink String
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    patientId String  @db.Uuid
    patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

    @@index([patientId])
    @@map("medical_reports")
}
